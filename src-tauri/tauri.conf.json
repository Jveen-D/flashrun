{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashRun",
  "version": "1.1.6",
  "identifier": "com.d8506.flashrun",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlashRun",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "d8506",
    "homepage": "https://github.com/Jveen-D/flashrun",
    "shortDescription": "A workspace for project commands and terminals",
    "longDescription": "FlashRun brings project scripts, running services and interactive terminals into one desktop workspace.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/assets/nsis-sidebar.bmp",
        "headerImage": "installer/assets/nsis-header.bmp",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "SimpChinese": "installer/languages/SimpChinese.nsh",
          "English": "installer/languages/English.nsh"
        },
        "installerHooks": "installer/branding.nsh"
      },
      "wix": {
        "bannerPath": "installer/assets/wix-banner.bmp",
        "dialogImagePath": "installer/assets/wix-dialog.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
